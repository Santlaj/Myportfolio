---
import Layout from '../../layouts/Layout.astro';
import { caseStudies, getAllCaseStudies, getCaseStudyBySlug } from '../../components/data/caseStudiesData';

export async function getStaticPaths() {
  const allStudies = getAllCaseStudies();
  return allStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const allStudies = getAllCaseStudies();
const currentIndex = allStudies.findIndex((s) => s.slug === study.slug);
const prevStudy = currentIndex > 0 ? allStudies[currentIndex - 1] : allStudies[allStudies.length - 1];
const nextStudy = currentIndex < allStudies.length - 1 ? allStudies[currentIndex + 1] : allStudies[0];
---

<Layout
  title={`${study.title} — Engineering Case Study | Santlaj Kumar`}
  description={study.tagline}
>
  <div class="case-study-page">
    <!-- Top Sticky Navigation Bar -->
    <header class="cs-topbar">
      <div class="cs-container topbar-inner">
        <a href="/#projects-timeline" class="back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Back to Portfolio</span>
        </a>

        <div class="topbar-center">
          <span class="topbar-project-name">{study.title}</span>
          <span class="topbar-sep">•</span>
          <span class="topbar-badge">{study.category}</span>
        </div>

        <div class="topbar-actions">
          {study.liveUrl && (
            <a href={study.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary-sm">
              <span>Live Demo</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          )}
          {study.githubUrl && (
            <a href={study.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-sm">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Source</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="cs-main">
      <div class="cs-container">
        <!-- Breadcrumb -->
        <nav class="cs-breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/case-studies">Case Studies</a>
          <span class="sep">/</span>
          <span class="current">{study.title}</span>
        </nav>

        <!-- Hero Section -->
        <section class="cs-hero" style={`--accent-color: ${study.heroAccent};`}>
          <div class="hero-badge-row">
            <span class="badge badge-accent">// {study.category.toUpperCase()}</span>
            <span class="badge badge-status">
              <span class="status-dot"></span>
              {study.status}
            </span>
            <span class="badge badge-subtle">{study.period}</span>
          </div>

          <h1 class="hero-title">{study.title}</h1>
          <p class="hero-subtitle">{study.subtitle}</p>
          <p class="hero-tagline">{study.tagline}</p>

          <!-- Quick Meta Grid -->
          <div class="hero-meta-grid">
            <div class="meta-item">
              <span class="meta-label">ROLE & SCOPE</span>
              <span class="meta-val">{study.role}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">PRIMARY ARCHITECTURE</span>
              <span class="meta-val">{study.architecture.components[1]?.layer || 'Full-Stack'}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">DATABASE & CACHE</span>
              <span class="meta-val">PostgreSQL • Redis</span>
            </div>
            <div class="meta-item actions-meta">
              <span class="meta-label">LINKS</span>
              <div class="meta-links">
                {study.liveUrl && (
                  <a href={study.liveUrl} target="_blank" rel="noopener noreferrer" class="link-inline">
                    Live Platform ↗
                  </a>
                )}
                {study.githubUrl && (
                  <a href={study.githubUrl} target="_blank" rel="noopener noreferrer" class="link-inline">
                    GitHub Code ↗
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>

        <!-- Metrics Showcase Strip -->
        <section class="cs-metrics-strip">
          <div class="metrics-grid">
            {study.metrics.map((metric) => (
              <div class="metric-card">
                <div class="metric-value">{metric.value}</div>
                <div class="metric-label">{metric.label}</div>
                <p class="metric-desc">{metric.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 1: Executive Summary & The Problem -->
        <section class="cs-section" id="overview">
          <div class="section-header">
            <span class="section-tag">// 01. EXECUTIVE SUMMARY</span>
            <h2 class="section-title">The Problem & System Scope</h2>
          </div>

          <div class="prose-card">
            <p class="lead-text">{study.summary}</p>
          </div>
        </section>

        <!-- Section 2: System Architecture & Data Flow -->
        <section class="cs-section" id="architecture">
          <div class="section-header">
            <span class="section-tag">// 02. SYSTEM ARCHITECTURE</span>
            <h2 class="section-title">End-to-End Architectural Design</h2>
          </div>

          <div class="prose-card mb-4">
            <p>{study.architecture.overview}</p>
          </div>

          <!-- Architecture Components Grid -->
          <div class="arch-components-grid">
            {study.architecture.components.map((comp, idx) => (
              <div class="arch-card">
                <div class="arch-layer-num">0{idx + 1}</div>
                <h3 class="arch-layer-name">{comp.layer}</h3>
                <div class="arch-tech-tags">
                  {comp.technologies.map((t) => (
                    <span class="tech-tag">{t}</span>
                  ))}
                </div>
                <p class="arch-layer-role">{comp.role}</p>
              </div>
            ))}
          </div>

          <!-- Numbered Data Flow Step-by-Step -->
          <div class="data-flow-box">
            <div class="data-flow-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
              <span>Execution Pipeline & Data Flow</span>
            </div>
            <ol class="data-flow-list">
              {study.architecture.dataFlow.map((step, idx) => (
                <li class="data-flow-step">
                  <span class="step-num">STEP {idx + 1}</span>
                  <span class="step-content">{step}</span>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- Section 3: Tech Stack & Rationale -->
        <section class="cs-section" id="tech-stack">
          <div class="section-header">
            <span class="section-tag">// 03. ENGINEERING DECISIONS</span>
            <h2 class="section-title">Technology Choices & Justifications</h2>
          </div>

          <div class="tech-reasons-grid">
            {study.techStack.map((item) => (
              <div class="tech-reason-card">
                <div class="tr-top">
                  <span class="tr-category">{item.category}</span>
                  <span class="tr-name">{item.name}</span>
                </div>
                <p class="tr-reason">{item.reason}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 4: Technical Challenges & Deep Dives -->
        <section class="cs-section" id="challenges">
          <div class="section-header">
            <span class="section-tag">// 04. CHALLENGES & SOLUTIONS</span>
            <h2 class="section-title">Deep Technical Breakthroughs</h2>
          </div>

          <div class="challenges-stack">
            {study.challenges.map((challenge, idx) => (
              <div class="challenge-card">
                <div class="challenge-header">
                  <span class="ch-badge">CHALLENGE 0{idx + 1}</span>
                  <h3 class="ch-title">{challenge.title}</h3>
                </div>

                <div class="ch-body">
                  <div class="ch-block problem-block">
                    <span class="ch-block-label">THE PROBLEM</span>
                    <p>{challenge.problem}</p>
                  </div>

                  <div class="ch-block tradeoffs-block">
                    <span class="ch-block-label">ENGINEERING TRADEOFFS</span>
                    <p>{challenge.tradeoffs}</p>
                  </div>

                  <div class="ch-block solution-block">
                    <span class="ch-block-label">IMPLEMENTED SOLUTION</span>
                    <p>{challenge.solution}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 5: Production Code Showcase -->
        {study.codeSnippets.length > 0 && (
          <section class="cs-section" id="code">
            <div class="section-header">
              <span class="section-tag">// 05. CODE IMPLEMENTATION</span>
              <h2 class="section-title">Production Engineering Logic</h2>
            </div>

            {study.codeSnippets.map((snippet) => (
              <div class="code-terminal">
                <div class="terminal-bar">
                  <div class="terminal-dots">
                    <span class="dot dot-red"></span>
                    <span class="dot dot-yellow"></span>
                    <span class="dot dot-green"></span>
                  </div>
                  <span class="terminal-title">{snippet.title}</span>
                  <span class="terminal-lang">{snippet.language.toUpperCase()}</span>
                </div>
                <div class="terminal-desc">{snippet.description}</div>
                <pre class="terminal-pre"><code>{snippet.code}</code></pre>
              </div>
            ))}
          </section>
        )}

        <!-- Section 6: Database & Data Schema -->
        <section class="cs-section" id="database">
          <div class="section-header">
            <span class="section-tag">// 06. DATA MODEL</span>
            <h2 class="section-title">Persistence & Schema Design</h2>
          </div>

          <div class="prose-card mb-4">
            <p>{study.databaseDesign.overview}</p>
          </div>

          <div class="entities-grid">
            {study.databaseDesign.keyEntities.map((entity) => (
              <div class="entity-card">
                <div class="entity-header">
                  <span class="entity-icon">❖</span>
                  <h3 class="entity-name">{entity.name}</h3>
                </div>
                <p class="entity-desc">{entity.description}</p>
                <div class="entity-fields">
                  <span class="fields-label">KEY FIELDS</span>
                  <ul class="fields-list">
                    {entity.fields.map((f) => (
                      <li><code>{f}</code></li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Section 7: Key Takeaways & Roadmap -->
        <section class="cs-section" id="learnings">
          <div class="section-header">
            <span class="section-tag">// 07. REFLECTION & ROADMAP</span>
            <h2 class="section-title">Key Learnings & Future Enhancements</h2>
          </div>

          <div class="learnings-grid">
            <div class="learnings-card">
              <h3 class="card-subtitle">
                <span class="check-icon">✓</span>
                Key Engineering Learnings
              </h3>
              <ul class="styled-list">
                {study.learnings.map((learning) => (
                  <li>{learning}</li>
                ))}
              </ul>
            </div>

            <div class="roadmap-card">
              <h3 class="card-subtitle">
                <span class="star-icon">⚡</span>
                Future Roadmap (v2)
              </h3>
              <ul class="styled-list">
                {study.futureRoadmap.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- Next / Prev Project Navigation Strip -->
        <nav class="cs-project-nav">
          <a href={`/case-studies/${prevStudy.slug}`} class="nav-proj-card prev">
            <span class="nav-dir">← PREVIOUS CASE STUDY</span>
            <span class="nav-title">{prevStudy.title}</span>
            <span class="nav-cat">{prevStudy.category}</span>
          </a>

          <a href={`/case-studies/${nextStudy.slug}`} class="nav-proj-card next">
            <span class="nav-dir">NEXT CASE STUDY →</span>
            <span class="nav-title">{nextStudy.title}</span>
            <span class="nav-cat">{nextStudy.category}</span>
          </a>
        </nav>

        <!-- Contact CTA Banner -->
        <div class="cs-cta-banner">
          <div class="cta-content">
            <span class="cta-tag">// HIRE OR COLLABORATE</span>
            <h3 class="cta-title">Interested in Discussing This Architecture?</h3>
            <p class="cta-desc">
              I am actively looking for engineering opportunities, backend roles, and impactful software projects. Let's talk system design and code.
            </p>
          </div>
          <div class="cta-actions">
            <a href="/#contact" class="btn btn-primary-lg">Get In Touch</a>
            <a href="/#projects-timeline" class="btn btn-outline-lg">View All Projects</a>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .case-study-page {
    background-color: #0c100d;
    color: #e5e7eb;
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    padding-bottom: 5rem;
  }

  .cs-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Top Sticky Bar */
  .cs-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(12, 16, 13, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(127, 176, 105, 0.15);
    padding: 0.85rem 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #9ca3af;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: #7fb069;
  }

  .topbar-center {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .topbar-project-name {
    font-weight: 700;
    color: #ffffff;
  }
  .topbar-sep {
    color: rgba(255, 255, 255, 0.2);
  }
  .topbar-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: #7fb069;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .btn-primary-sm {
    background: #7fb069;
    color: #0c100d;
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
  }
  .btn-primary-sm:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  .btn-outline-sm {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e5e7eb;
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
  }
  .btn-outline-sm:hover {
    border-color: #7fb069;
    color: #7fb069;
  }
  .btn-primary-lg {
    background: #7fb069;
    color: #0c100d;
    padding: 0.75rem 1.6rem;
    font-size: 0.95rem;
    border-radius: 10px;
  }
  .btn-primary-lg:hover {
    filter: brightness(1.12);
  }
  .btn-outline-lg {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 0.75rem 1.6rem;
    font-size: 0.95rem;
    border-radius: 10px;
  }
  .btn-outline-lg:hover {
    border-color: #7fb069;
    color: #7fb069;
  }

  /* Breadcrumb */
  .cs-breadcrumb {
    padding: 2rem 0 1rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-family: 'JetBrains Mono', monospace;
    color: #6b7280;
  }
  .cs-breadcrumb a {
    color: #9ca3af;
    text-decoration: none;
  }
  .cs-breadcrumb a:hover {
    color: #7fb069;
  }
  .cs-breadcrumb .sep {
    color: #4b5563;
  }
  .cs-breadcrumb .current {
    color: #7fb069;
  }

  /* Hero Section */
  .cs-hero {
    padding: 2rem 0 3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
  }
  .badge-accent {
    background: rgba(127, 176, 105, 0.12);
    color: #7fb069;
    border: 1px solid rgba(127, 176, 105, 0.3);
  }
  .badge-status {
    background: rgba(59, 130, 246, 0.1);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.25);
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 6px #60a5fa;
  }
  .badge-subtle {
    background: rgba(255, 255, 255, 0.04);
    color: #9ca3af;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #ffffff 40%, #7fb069 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtitle {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 600;
    color: #d1d5db;
    margin-bottom: 1rem;
  }
  .hero-tagline {
    font-size: 1.05rem;
    color: #9ca3af;
    line-height: 1.7;
    max-width: 820px;
    margin-bottom: 2.2rem;
  }

  /* Quick Meta Grid */
  .hero-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    background: rgba(22, 27, 34, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .meta-label {
    font-size: 0.68rem;
    font-family: 'JetBrains Mono', monospace;
    color: #6b7280;
    letter-spacing: 0.06em;
  }
  .meta-val {
    font-size: 0.92rem;
    font-weight: 600;
    color: #f3f4f6;
  }
  .meta-links {
    display: flex;
    gap: 1rem;
  }
  .link-inline {
    font-size: 0.88rem;
    color: #7fb069;
    text-decoration: none;
    font-weight: 600;
  }
  .link-inline:hover {
    text-decoration: underline;
  }

  /* Metrics Strip */
  .cs-metrics-strip {
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1.25rem;
  }
  .metric-card {
    background: linear-gradient(135deg, rgba(22, 27, 34, 0.8) 0%, rgba(14, 18, 15, 0.9) 100%);
    border: 1px solid rgba(127, 176, 105, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .metric-card:hover {
    transform: translateY(-2px);
    border-color: #7fb069;
  }
  .metric-value {
    font-size: 2.2rem;
    font-weight: 800;
    font-family: 'JetBrains Mono', monospace;
    color: #7fb069;
    line-height: 1;
    margin-bottom: 0.4rem;
  }
  .metric-label {
    font-size: 0.78rem;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .metric-desc {
    font-size: 0.8rem;
    color: #9ca3af;
    line-height: 1.5;
  }

  /* Section Layout */
  .cs-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .section-header {
    margin-bottom: 2rem;
  }
  .section-tag {
    display: block;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    color: #7fb069;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .prose-card {
    background: rgba(22, 27, 34, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 2rem;
