---
import Layout from '../../layouts/Layout.astro';
import { getAllCaseStudies } from '../../components/data/caseStudiesData';

const caseStudies = getAllCaseStudies();
---

<Layout
  title="Engineering Case Studies — Santlaj Kumar"
  description="In-depth architectural breakdowns, technical challenges, and production system designs by Santlaj Kumar."
>
  <div class="cs-index-page">
    <!-- Top Bar -->
    <header class="cs-topbar">
      <div class="cs-container topbar-inner">
        <a href="/" class="back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Back to Portfolio</span>
        </a>
        <div class="topbar-badge">// ENGINEERING CASE STUDIES</div>
      </div>
    </header>

    <main class="cs-main">
      <div class="cs-container">
        <!-- Hero Header -->
        <section class="index-hero">
          <span class="index-tag">// ARCHITECTURAL DEEP DIVES</span>
          <h1 class="index-title">Production Case Studies</h1>
          <p class="index-subtitle">
            Comprehensive architectural breakdowns, technical trade-offs, database schemas, and production code for systems I have designed and engineered.
          </p>
        </section>

        <!-- Case Studies List Grid -->
        <div class="case-studies-grid">
          {caseStudies.map((study, index) => (
            <article class="study-card" style={`--card-accent: ${study.heroAccent};`}>
              <div class="card-top">
                <div class="card-badges">
                  <span class="study-num">0{index + 1}</span>
                  <span class="study-cat">{study.category}</span>
                </div>
                <span class="study-status">{study.status}</span>
              </div>

              <h2 class="study-title">
                <a href={`/case-studies/${study.slug}`}>{study.title}</a>
              </h2>
              <p class="study-sub">{study.subtitle}</p>
              <p class="study-tagline">{study.tagline}</p>

              <!-- Key Metrics Bar -->
              <div class="card-metrics-row">
                {study.metrics.slice(0, 3).map((m) => (
                  <div class="card-metric">
                    <span class="metric-val">{m.value}</span>
                    <span class="metric-lbl">{m.label}</span>
                  </div>
                ))}
              </div>

              <!-- Tech Pills -->
              <div class="card-tech-pills">
                {study.techStack.slice(0, 4).map((tech) => (
                  <span class="tech-pill">{tech.name}</span>
                ))}
              </div>

              <!-- Card Actions -->
              <div class="card-footer">
                <a href={`/case-studies/${study.slug}`} class="btn-read-study">
                  <span>Read Full Case Study</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>

                <div class="external-links">
                  {study.liveUrl && (
                    <a href={study.liveUrl} target="_blank" rel="noopener noreferrer" class="icon-link" title="Live Demo">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  )}
                  {study.githubUrl && (
                    <a href={study.githubUrl} target="_blank" rel="noopener noreferrer" class="icon-link" title="GitHub Source">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
  .cs-index-page {
    background-color: #0c100d;
    color: #e5e7eb;
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    padding-bottom: 5rem;
  }
  .cs-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .cs-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(12, 16, 13, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(127, 176, 105, 0.15);
    padding: 0.85rem 0;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #9ca3af;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .back-link:hover {
    color: #7fb069;
  }
  .topbar-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #7fb069;
    font-weight: 700;
  }

  .index-hero {
    padding: 3.5rem 0 2.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 3rem;
  }
  .index-tag {
    display: block;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    color: #7fb069;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .index-title {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 0.8rem;
    background: linear-gradient(135deg, #ffffff 40%, #7fb069 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .index-subtitle {
    font-size: 1.1rem;
    color: #9ca3af;
    line-height: 1.7;
    max-width: 780px;
  }

  .case-studies-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .study-card {
    background: linear-gradient(135deg, rgba(22, 27, 34, 0.85) 0%, rgba(14, 18, 15, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    padding: 2.25rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .study-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--card-accent, #7fb069), transparent);
  }
  .study-card:hover {
    border-color: var(--card-accent, #7fb069);
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .card-badges {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .study-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--card-accent, #7fb069);
    font-weight: 700;
  }
  .study-cat {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .study-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    color: #d1d5db;
  }

  .study-title {
    font-size: 1.85rem;
    font-weight: 800;
    margin-bottom: 0.3rem;
  }
  .study-title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .study-title a:hover {
    color: var(--card-accent, #7fb069);
  }
  .study-sub {
    font-size: 1.05rem;
    font-weight: 600;
    color: #d1d5db;
    margin-bottom: 0.8rem;
  }
  .study-tagline {
    font-size: 0.95rem;
    color: #9ca3af;
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .card-metrics-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .card-metric {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .metric-val {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--card-accent, #7fb069);
  }
  .metric-lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .tech-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d1d5db;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .btn-read-study {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--card-accent, #7fb069);
    color: #0c100d;
    padding: 0.65rem 1.35rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-read-study:hover {
    filter: brightness(1.12);
    transform: translateX(2px);
  }
  .external-links {
    display: flex;
    gap: 0.8rem;
  }
  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d1d5db;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .icon-link:hover {
    border-color: var(--card-accent, #7fb069);
    color: #ffffff;
  }
</style>
