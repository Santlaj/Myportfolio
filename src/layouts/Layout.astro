---
import siteConfig, { getSiteUrl } from '../config/site';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonical?: string;
  showPreloader?: boolean;
}

const {
  title,
  description = siteConfig.description,
  keywords = siteConfig.keywords.join(', '),
  ogImage = "/og-image.jpg",
  canonical = Astro.url.pathname,
  showPreloader = (Astro.url.pathname === '/' || Astro.url.pathname === ''),
} = Astro.props;

const siteUrl = getSiteUrl();
const fullUrl = new URL(canonical, siteUrl);
const fullOgImage = new URL(ogImage, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#7fb069" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Santlaj Kumar" />
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Santlaj Kumar - Software Engineer & Full-Stack Developer Portfolio"
    />
    <meta property="og:site_name" content="Santlaj Kumar - Portfolio" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta
      name="twitter:image:alt"
      content="Santlaj Kumar - Software Engineer & Full-Stack Developer Portfolio"
    />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Performance optimizations -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Resource hints for better performance -->
    <link rel="prefetch" href="/resume.pdf" />
    <link rel="preload" href="/favicon.png" as="image" type="image/png" />

    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Three.js for 3D Interactive WebGL Globe -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <!-- Lenis for Cinematic Inertia Smooth Scrolling -->
    <script is:inline src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>

    <!-- Material Icons -->
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/icon?family=Material+Icons"
        rel="stylesheet"
      />
    </noscript>

    <!-- Schema.org structured data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": siteConfig.name,
        "jobTitle": siteConfig.title,
        "url": siteConfig.url,
        "image": new URL(siteConfig.profileImage, siteUrl).toString(),
        "email": siteConfig.email,
        "telephone": "+1-XXX-XXX-XXXX",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "IN"
        },
        "sameAs": [
          siteConfig.linkedin,
          siteConfig.github
        ],
        "worksFor": {
          "@type": "EducationalOrganization",
          "name": "Lovely Professional University",
          "url": "https://www.lpu.in"
        },
        "description": "B.Tech Computer Science & Engineering student at Lovely Professional University focused on software engineering, backend systems, and data structures & algorithms.",
        "knowsAbout": [
          "C++",
          "JavaScript",
          "React",
          "Next.js",
          "Node.js",
          "Express.js",
          "PostgreSQL",
          "Redis",
          "Prisma",
          "Supabase",
          "SQL",
          "Java",
          "Data Structures & Algorithms",
          "REST APIs",
          "Git"
        ],
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Lovely Professional University"
        },
        "hasCredential": [
          {
            "@type": "EducationalOccupationalCredential",
            "credentialCategory": "degree",
            "educationalLevel": "Bachelor"
          }
        ]
      }
    </script>

    <!-- Additional structured data for portfolio -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": `${siteConfig.name} - Portfolio`,
        "url": siteConfig.url,
        "description": siteConfig.description,
        "author": {
          "@type": "Person",
          "name": siteConfig.name
        },
        "inLanguage": "en-US",
        "copyrightYear": "2024",
        "genre": "Portfolio"
      }
    </script>
  <body>
    {showPreloader && (
      <div id="system-preloader" aria-hidden="true">
        <div class="preloader-orbs">
          <div class="orb-ring"></div>
          <div class="orb-core"></div>
        </div>

        <div class="preloader-center">
          <div class="preloader-brand">santlaj.kumar</div>
          <div class="preloader-terminal">
            <div class="term-line line-1">> initializing system...</div>
            <div class="term-line line-2">> loading 3d engine...</div>
            <div class="term-line line-3">> compiling shaders...</div>
            <div class="term-line line-4">> system ready<span class="term-cursor">_</span></div>
          </div>
        </div>
      </div>
    )}

    <slot />

    <script is:inline>
      // 0. System Preloader Dismiss Engine
      (function initPreloader() {
        const preloader = document.getElementById('system-preloader');
        if (!preloader) return;

        let dismissed = false;
        function dismiss() {
          if (dismissed) return;
          dismissed = true;
          preloader.classList.add('loaded');
          setTimeout(() => {
            preloader.style.display = 'none';
          }, 700);
        }

        if (document.readyState === 'complete') {
          setTimeout(dismiss, 1200);
        } else {
          window.addEventListener('load', () => {
            setTimeout(dismiss, 1200);
          });
        }

        // Safety fallback: maximum 2.4s so the user is never stuck
        setTimeout(dismiss, 2400);
      })();
      // 1. Initialize Lenis Smooth Inertia Scroll Engine
      (function initSmoothScroll() {
        function startLenis() {
          if (window.Lenis) {
            const lenis = new window.Lenis({
              duration: 1.2,
              easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
              orientation: 'vertical',
              gestureOrientation: 'vertical',
              smoothWheel: true,
              wheelMultiplier: 1.1,
              touchMultiplier: 1.6,
              infinite: false,
            });

            window.lenis = lenis;

            function raf(time) {
              lenis.raf(time);
              requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);

            lenis.on('scroll', (e) => {
              window.dispatchEvent(new CustomEvent('lenis-scroll', { detail: e }));
            });
          } else {
            setTimeout(startLenis, 80);
          }
        }
        startLenis();

        // 2. Cinematic Scroll Reveal Engine (Blur-In + Fade-Up + Scale)
        function initScrollReveals() {
          const selectors = [
            '#about > .MuiContainer-root > *',
            '#skills > .MuiContainer-root > *',
            '#projects > .MuiContainer-root > *',
            '#certifications > .MuiContainer-root > *',
            '#contact > .MuiContainer-root > *',
            '.MuiPaper-root',
            '.MuiCard-root',
            '.MuiTimelineItem-root',
            '.scroll-reveal',
          ];

          const targets = document.querySelectorAll(selectors.join(', '));
          targets.forEach((el, index) => {
            // Exclude the hero section from delayed scroll reveals so it displays immediately
            if (el.closest('#hero') || el.id === 'hero') return;

            el.classList.add('scroll-reveal-item');
            const staggerDelay = (index % 3) * 0.09;
            el.style.setProperty('--reveal-delay', `${staggerDelay}s`);
          });

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
              }
            });
          }, {
            rootMargin: '0px 0px -60px 0px',
            threshold: 0.05,
          });

          document.querySelectorAll('.scroll-reveal-item').forEach((el) => {
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollReveals);
        } else {
          setTimeout(initScrollReveals, 100);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Lenis Smooth Scrolling Core CSS */
  html.lenis, html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }
  .lenis.lenis-stopped {
    overflow: hidden;
  }
  .lenis.lenis-scrolling iframe {
    pointer-events: none;
  }

  /* Cinematic Scroll Reveal (Blur-In + Fade-Up + Scale) */
  .scroll-reveal-item {
    opacity: 0;
    transform: translateY(38px) scale(0.97);
    filter: blur(8px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0s);
    will-change: opacity, transform, filter;
  }

  .scroll-reveal-item.is-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0px);
  }

  .scroll-reveal-item:hover {
    transition-delay: 0s !important;
  }

  body {
    font-family: "Inter", "Roboto", sans-serif;
    background-color: #0c100d;
    color: #ffffff;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #1a1a1a;
  }

  ::-webkit-scrollbar-thumb {
    background: #7fb069;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #a8d084;
  }

  /* Keyframe animations */
  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-10px);
    }
    60% {
      transform: translateX(-50%) translateY(-5px);
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Cyberpunk System Preloader Styling */
  #system-preloader {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background-color: #0c100d;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    pointer-events: all;
  }

  #system-preloader.loaded {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .preloader-orbs {
    position: absolute;
    top: 2.5rem;
    left: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .orb-ring {
    width: 26px;
    height: 26px;
    border: 1.5px solid rgba(127, 176, 105, 0.35);
    border-radius: 50%;
    animation: ringPulse 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .orb-core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7fb069;
    box-shadow: 0 0 10px #7fb069, 0 0 20px rgba(127, 176, 105, 0.6);
    animation: coreGlow 1.6s ease-in-out infinite alternate;
  }

  @keyframes ringPulse {
    0% { transform: scale(0.9); opacity: 0.3; }
    50% { transform: scale(1.2); opacity: 0.85; }
    100% { transform: scale(0.9); opacity: 0.3; }
  }

  @keyframes coreGlow {
    0% { transform: scale(0.85); opacity: 0.6; }
    100% { transform: scale(1.25); opacity: 1; }
  }

  .preloader-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .preloader-brand {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, #7fb069 0%, #e07a5f 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 2rem;
    text-shadow: 0 0 40px rgba(127, 176, 105, 0.25);
  }

  .preloader-terminal {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    color: #9ca3af;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    min-width: 250px;
  }

  .term-line {
    opacity: 0;
    transform: translateY(4px);
    animation: termFadeIn 0.35s ease forwards;
  }

  .term-line.line-1 {
    animation-delay: 0.1s;
    color: #9ca3af;
  }
  .term-line.line-2 {
    animation-delay: 0.45s;
    color: #9ca3af;
  }
  .term-line.line-3 {
    animation-delay: 0.85s;
    color: #9ca3af;
  }
  .term-line.line-4 {
    animation-delay: 1.2s;
    color: #7fb069;
    font-weight: 600;
  }

  .term-cursor {
    display: inline-block;
    color: #7fb069;
    animation: cursorBlink 0.75s infinite;
    font-weight: 700;
    margin-left: 2px;
  }

  @keyframes termFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
